{
  "name": "context-pilot",
  "private": true,
  "version": "0.1.85",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint extension/src extension/tests --max-warnings=0 && prettier --check --ignore-unknown package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.json tsconfig.build.json eslint.config.mjs extension deployment scripts native-host",
    "build": "tsc -p tsconfig.build.json && node scripts/bump-extension-version.mjs && node scripts/build-extension.mjs",
    "test:unit": "vitest run extension/tests/unit",
    "test:fixture": "vitest run extension/tests/fixture",
    "test:e2e": "vitest run extension/tests/e2e",
    "test:chrome-extension": "node scripts/chrome-extension-smoke.mjs",
    "test:chrome-collection": "node --experimental-websocket scripts/chrome-collection-read-smoke.mjs",
    "test:chrome-analysis-data": "node --experimental-websocket scripts/chrome-analysis-data-smoke.mjs",
    "test:chrome-s1": "node --experimental-websocket scripts/chrome-s1-smoke.mjs",
    "test:chrome-page-api-discovery": "node --experimental-websocket scripts/chrome-page-api-discovery-smoke.mjs",
    "test:chrome-preview": "node scripts/chrome-preview-e2e.mjs",
    "test:native-host": "dotnet build native-host/ContextPilot.Host.csproj --nologo && node scripts/native-host-smoke.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "check:module-boundaries": "node scripts/check-module-boundaries.mjs",
    "test": "pnpm typecheck && pnpm lint && pnpm build && pnpm validate:package && pnpm test:unit && pnpm test:fixture && pnpm test:e2e",
    "validate:package": "node scripts/validate-package.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "5.7.3",
    "vitest": "3.2.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.46.4",
    "prettier": "3.6.2"
  }
}
