{
  "manifest_version": 3,
  "name": "Company Web Agent",
  "version": "31.0.1",
  "description": "Enterprise browser agent with managed policy and verified UI automation.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://*.company.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://ai.company.net https://mcp.company.net https://audit.company.net;"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.company.net/*"],
      "js": [
        "src/content/accessibility-tree.js",
        "src/content/content.js",
        "src/content/agent-visual-indicator.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "WebBrain",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open WebBrain panel"
    }
  },
  "web_accessible_resources": []
}
