{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": { "type": "string", "const": "wca.task/v1" },
    "frameDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "templateVersion": { "type": "string", "const": "controller-v1" },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "modelRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "taskRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "planRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graphRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capabilityRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancellationGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": { "type": "string", "enum": ["ask", "act"] },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "taskId",
        "taskRevision",
        "planRevision",
        "graphRevision",
        "evidenceRevision",
        "capabilityRevision",
        "cancellationGeneration",
        "mode",
        "scopeId"
      ],
      "additionalProperties": false
    },
    "answers": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "choice" },
            "choice": { "type": "string", "minLength": 1, "maxLength": 128 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "probabilities": {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "required": ["type", "choice", "confidence", "probabilities"],
          "additionalProperties": false
        },
        "evidence_sufficient": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "noul" },
            "noul": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["type", "noul"],
          "additionalProperties": false
        }
      },
      "required": ["decision", "evidence_sufficient"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "frameDigest",
    "candidateDigest",
    "templateVersion",
    "model",
    "modelRevision",
    "context",
    "answers",
    "usage"
  ],
  "additionalProperties": false
}
