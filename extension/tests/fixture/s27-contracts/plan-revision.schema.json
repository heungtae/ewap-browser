{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": { "type": "string", "const": "wca.task/v1" },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "taskRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "planRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graphRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capabilityRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancellationGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": { "type": "string", "enum": ["ask", "act"] },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "taskId",
        "taskRevision",
        "planRevision",
        "graphRevision",
        "evidenceRevision",
        "capabilityRevision",
        "cancellationGeneration",
        "mode",
        "scopeId"
      ],
      "additionalProperties": false
    },
    "steps": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "tool": {
            "type": "string",
            "enum": [
              "web.discover",
              "web.search_codebase",
              "web.inspect",
              "web.get_capabilities",
              "web.navigate",
              "web.switch_tab",
              "web.click",
              "web.fill",
              "web.select",
              "web.scroll",
              "web.wait_for",
              "web.extract",
              "web.query",
              "web.get_chart_data",
              "web.get_table_data",
              "web.get_observed_api",
              "analysis.run",
              "task.verify",
              "task.request_approval",
              "task.complete",
              "web.invoke_action"
            ]
          },
          "actionRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "dependencies": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "parameters": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "effect": {
            "type": "string",
            "enum": ["read", "navigation", "local-ui", "external", "unknown"]
          },
          "goalPredicateRefs": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "preconditionRefs": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        },
        "required": [
          "id",
          "tool",
          "dependencies",
          "parameters",
          "effect",
          "goalPredicateRefs",
          "preconditionRefs"
        ],
        "additionalProperties": false
      }
    },
    "allowedScopeIds": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "allowedOrigins": {
      "maxItems": 8,
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "allowedTabRefs": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "sourceCandidateIds": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "evidenceRefs": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "unresolvedInputs": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "goalPredicates": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "reservations": {
      "type": "object",
      "properties": {
        "toolInvocations": { "type": "integer", "minimum": 0, "maximum": 64 },
        "mutations": { "type": "integer", "minimum": 0, "maximum": 12 }
      },
      "required": ["toolInvocations", "mutations"],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "revision",
    "context",
    "steps",
    "allowedScopeIds",
    "allowedOrigins",
    "allowedTabRefs",
    "sourceCandidateIds",
    "evidenceRefs",
    "unresolvedInputs",
    "goalPredicates",
    "reservations"
  ],
  "additionalProperties": false
}
