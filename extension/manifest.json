{
  "manifest_version": 3,
  "name": "ContextPilot (development)",
  "version": "0.1.85",
  "icons": {
    "16": "assets/icons/contextpilot-16.png",
    "32": "assets/icons/contextpilot-32.png",
    "48": "assets/icons/contextpilot-48.png",
    "128": "assets/icons/contextpilot-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "debugger",
    "offscreen"
  ],
  "storage": {
    "managed_schema": "managed-storage-schema.json"
  },
  "host_permissions": ["https://*/*"],
  "optional_host_permissions": ["http://*/*", "<all_urls>"],
  "background": {
    "service_worker": "src/service-worker/entry.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https: http:"
  },
  "options_ui": {
    "page": "src/settings/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/entry.js"],
      "run_at": "document_start"
    }
  ]
}
